# ─────────────────────────────────────────────────────────────
#  Variables de Lagunillas Central
#  En Vercel: Settings → Environment Variables (una por una)
#  En tu computadora: copia este archivo como .env.local
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# Supabase → Project Settings → API → service_role (¡SECRETA! nunca con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Notificaciones push. Genera un par nuevo con:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@gmail.com

# Largo del código que llega por correo (Supabase → Email OTP Length). Opcional, por defecto 8
NEXT_PUBLIC_OTP_LENGTH=8
